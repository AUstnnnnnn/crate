Screen {
    background: $background;
}

#banner {
    height: 3;
    padding: 1 0 0 2;
    background: $background;
    border-bottom: dashed $primary 30%;
}

#body {
    padding: 1 2;
}

#urlbar {
    height: 3;
}

#url {
    width: 1fr;
    background: $surface;
    border: round $primary 40%;
    color: $foreground;
}

#url:focus {
    border: round $primary;
}

/* preset pads — the signature: three tactile pads filling the row, active lit */
#preset {
    layout: horizontal;
    height: auto;
    width: 1fr;
    margin: 1 0;
    background: $background;
    border: none;
}

#preset > RadioButton {
    width: 1fr;
    content-align: center middle;
    text-align: center;
    padding: 0 2;
    margin: 0 1;
    background: $surface;
    color: $text-muted;
    border: round $panel;
}

#preset > RadioButton.-on {
    background: $primary 15%;
    color: $primary;
    text-style: bold;
    border: round $primary;
}

/* kill the block-cursor box drawn over the pad label — the pill is enough */
#preset > RadioButton > .toggle--label {
    background: transparent;
    text-style: none;
}

#preset > RadioButton.-on > .toggle--label {
    background: transparent;
    color: $primary;
    text-style: bold;
}

#queue {
    height: auto;
    max-height: 18;
    background: $surface;
    color: $foreground;
    scrollbar-size-vertical: 1;
}

#queue > .datatable--header {
    background: $panel;
    color: $primary;
    text-style: bold;
}

#queue > .datatable--cursor {
    background: $primary 20%;
    color: $foreground;
}

#empty {
    height: auto;
    padding: 2 0;
    width: 1fr;
    content-align: center middle;
    text-align: center;
    color: $text-muted;
    text-style: italic;
}

/* clip + advanced screens */
#cliphead, #advhead {
    padding: 1 2;
    background: $panel;
    color: $primary;
    text-style: bold;
}

ClipScreen > Input, AdvancedScreen > Input {
    margin: 1 2 0 2;
    background: $surface;
    border: round $primary 40%;
}

#clipstatus, #advstatus {
    padding: 1 2;
    color: $text-muted;
}

AdvancedScreen > Checkbox {
    margin: 1 2 0 2;
    background: $surface;
}
